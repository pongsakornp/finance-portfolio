# Database (required)
# Local docker compose also needs POSTGRES_PASSWORD below
DATABASE_URL=postgres://finance:CHANGEME@localhost:5432/finance
POSTGRES_PASSWORD=CHANGEME

# Auth.js secret - generate with: openssl rand -base64 32
AUTH_SECRET=

# Public origin Auth.js uses for callbacks/redirects when NOT behind a proxy.
# Leave empty when behind a reverse proxy (Dokploy sets x-forwarded-host).
AUTH_URL=

# OAuth (optional; each provider is enabled only when both values are set)
# Google callback: https://<host>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# LINE requires Email address permission and the `openid profile email` scope.
# LINE callback: https://<host>/api/auth/callback/line
AUTH_LINE_ID=
AUTH_LINE_SECRET=

# Cron jobs (snapshots + quote warmup). Set to false to disable.
CRON_ENABLED=true

# CoinMarketCap (required for crypto quotes and five-year price history)
COINMARKETCAP_API_KEY=
